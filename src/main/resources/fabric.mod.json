{
	"schemaVersion": 1,
	"id": "timberworks",
	"version": "${version}",
	"name": "Timberworks",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/timberworks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"rndm_access.timberworks.Timberworks"
		],
		"client": [
			"rndm_access.timberworks.TimberworksClient"
		],
      "rei_client": [
        "rndm_access.timberworks.rei.ReiTimberworksClientPlugin"
      ],
      "rei_common": [
        "rndm_access.timberworks.rei.ReiTimberworksCommonPlugin"
      ]
    },
	"mixins": [
		"timberworks.mixins.json",
		{
			"config": "timberworks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}